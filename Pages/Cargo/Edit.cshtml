@page
@model wt_lab5_5razor_yushkevich.Pages.Cargo.EditModel
@{
    ViewData["Title"] = "Редактировать груз";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb mb-3">
        <li class="breadcrumb-item"><a asp-page="/Index">Главная</a></li>
        <li class="breadcrumb-item"><a asp-page="/Cargo/Index">Грузы</a></li>
        <li class="breadcrumb-item">
            <a asp-page="/Cargo/Details" asp-route-id="@Model.Cargo.Id">@Model.Cargo.Name</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Редактирование</li>
    </ol>
</nav>

<div class="page-heading mb-4">
    <div>
        <h1 class="h2 fw-bold mb-2">Редактирование груза</h1>
        <p class="text-muted mb-0">Измените данные карточки и сохраните результат.</p>
    </div>
    <a asp-page="/Cargo/Details" asp-route-id="@Model.Cargo.Id" class="btn btn-outline-secondary">
        <svg class="icon me-1" aria-hidden="true"><use href="#i-arrow-left" /></svg>
        К карточке
    </a>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-8">
        <form method="post" class="card border-0 shadow-sm rounded-4" novalidate>
            <input type="hidden" asp-for="Cargo.Id" />
            <div class="card-body p-4 p-lg-5">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger d-flex gap-2" role="alert">
                        <svg class="icon flex-shrink-0 mt-1" aria-hidden="true"><use href="#i-alert" /></svg>
                        <div>
                            <strong>Проверьте заполнение формы.</strong>
                            <div asp-validation-summary="ModelOnly" class="small mb-0 mt-1"></div>
                        </div>
                    </div>
                }

                <div class="row g-3 g-md-4">
                    <div class="col-12">
                        <label asp-for="Cargo.Name" class="form-label fw-semibold">
                            Название <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Cargo.Name" class="form-control form-control-lg" />
                        <span asp-validation-for="Cargo.Name" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Cargo.Category" class="form-label fw-semibold">
                            Категория <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Cargo.Category" class="form-control" list="category-options" />
                        <datalist id="category-options">
                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category"></option>
                            }
                        </datalist>
                        <span asp-validation-for="Cargo.Category" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Cargo.Location" class="form-label fw-semibold">
                            Место хранения <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Cargo.Location" class="form-control" />
                        <span asp-validation-for="Cargo.Location" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label asp-for="Cargo.Quantity" class="form-label fw-semibold">
                            Количество, шт. <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Cargo.Quantity" class="form-control" type="number" min="1" step="1" />
                        <span asp-validation-for="Cargo.Quantity" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label asp-for="Cargo.Weight" class="form-label fw-semibold">
                            Вес одной единицы, кг <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Cargo.Weight" class="form-control" type="number" min="0.01" step="0.01" />
                        <span asp-validation-for="Cargo.Weight" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Cargo.Description" class="form-label fw-semibold">
                            Описание <span class="text-danger">*</span>
                        </label>
                        <textarea asp-for="Cargo.Description" class="form-control" rows="4"></textarea>
                        <div class="form-text">До 300 символов.</div>
                        <span asp-validation-for="Cargo.Description" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <div class="form-check form-switch p-3 ps-5 rounded-3 bg-light border">
                            <input asp-for="Cargo.IsAvailable" class="form-check-input" role="switch" />
                            <label asp-for="Cargo.IsAvailable" class="form-check-label fw-semibold"></label>
                            <div class="form-text mb-0">Снимите переключатель, если груз недоступен к отгрузке.</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-footer bg-transparent border-top p-4 d-flex flex-column flex-sm-row gap-2 justify-content-between">
                <a asp-page="/Cargo/Index" class="btn btn-outline-secondary order-2 order-sm-1">
                    Отмена
                </a>
                <div class="d-flex flex-column flex-sm-row gap-2 order-1 order-sm-2">
                    <a asp-page="/Cargo/Delete" asp-route-id="@Model.Cargo.Id" class="btn btn-outline-danger">
                        <svg class="icon me-1" aria-hidden="true"><use href="#i-trash" /></svg>
                        Удалить
                    </a>
                    <button type="submit" class="btn btn-primary btn-lg px-4">
                        <svg class="icon me-1" aria-hidden="true"><use href="#i-check" /></svg>
                        Сохранить изменения
                    </button>
                </div>
            </div>
        </form>
    </div>

    <div class="col-12 col-lg-4">
        <aside class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <span class="badge text-bg-primary rounded-pill mb-3">ID: @Model.Cargo.Id</span>
                <h2 class="h5 fw-semibold">Текущая карточка</h2>
                <p class="text-muted small mb-3">@Model.Cargo.Description</p>
                <div class="d-flex justify-content-between border-top py-2">
                    <span class="text-muted">Количество</span>
                    <strong>@Model.Cargo.Quantity.ToString("N0") шт.</strong>
                </div>
                <div class="d-flex justify-content-between border-top py-2">
                    <span class="text-muted">Общий вес</span>
                    <strong>@Model.Cargo.TotalWeight.ToString("N2") кг</strong>
                </div>
                <div class="d-flex justify-content-between border-top py-2">
                    <span class="text-muted">Статус</span>
                    <span class="badge rounded-pill @(Model.Cargo.IsAvailable ? "text-bg-success" : "text-bg-secondary")">
                        @Model.Cargo.Status
                    </span>
                </div>
            </div>
        </aside>

        <div class="alert alert-warning border-0 shadow-sm rounded-4 mb-0" role="alert">
            <div class="d-flex gap-2">
                <svg class="icon flex-shrink-0 mt-1" aria-hidden="true"><use href="#i-alert" /></svg>
                <div class="small">
                    Изменения сохраняются в общем хранилище в памяти и будут доступны
                    на всех страницах до перезапуска приложения.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
