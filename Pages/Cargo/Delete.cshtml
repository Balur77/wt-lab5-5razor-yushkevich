@page
@model wt_lab5_5razor_yushkevich.Pages.Cargo.DeleteModel
@{
    ViewData["Title"] = "Удалить груз";
    var cargo = Model.Cargo!;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb mb-3">
        <li class="breadcrumb-item"><a asp-page="/Index">Главная</a></li>
        <li class="breadcrumb-item"><a asp-page="/Cargo/Index">Грузы</a></li>
        <li class="breadcrumb-item">
            <a asp-page="/Cargo/Details" asp-route-id="@cargo.Id">@cargo.Name</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Удаление</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8 col-xl-7">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="delete-header p-4 p-lg-5">
                <span class="delete-icon">
                    <svg class="icon" aria-hidden="true"><use href="#i-trash" /></svg>
                </span>
                <h1 class="h3 fw-bold mt-3 mb-2">Удалить груз?</h1>
                <p class="mb-0 opacity-75">
                    Действие нельзя отменить: позиция будет удалена из общего хранилища.
                </p>
            </div>
            <div class="card-body p-4 p-lg-5">
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <span class="badge text-bg-light border rounded-pill">ID: @cargo.Id</span>
                    <span class="badge text-bg-primary rounded-pill">@cargo.Category</span>
                    <span class="badge rounded-pill @(cargo.IsAvailable ? "text-bg-success" : "text-bg-secondary")">
                        @cargo.Status
                    </span>
                </div>
                <h2 class="h4 fw-semibold">@cargo.Name</h2>
                <p class="text-muted">@cargo.Description</p>

                <dl class="row g-3 border-top pt-4 mb-4">
                    <div class="col-6 col-md-3">
                        <dt class="detail-label">Количество</dt>
                        <dd class="detail-value mb-0">@cargo.Quantity.ToString("N0") шт.</dd>
                    </div>
                    <div class="col-6 col-md-3">
                        <dt class="detail-label">Общий вес</dt>
                        <dd class="detail-value mb-0">@cargo.TotalWeight.ToString("N2") кг</dd>
                    </div>
                    <div class="col-12 col-md-6">
                        <dt class="detail-label">Место хранения</dt>
                        <dd class="detail-value mb-0">@cargo.Location</dd>
                    </div>
                </dl>

                <form method="post" asp-route-id="@cargo.Id" class="d-flex flex-column flex-sm-row gap-2">
                    <button type="submit" class="btn btn-danger btn-lg px-4">
                        <svg class="icon me-1" aria-hidden="true"><use href="#i-trash" /></svg>
                        Да, удалить
                    </button>
                    <a asp-page="/Cargo/Details" asp-route-id="@cargo.Id" class="btn btn-outline-secondary btn-lg">
                        Отмена
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>
