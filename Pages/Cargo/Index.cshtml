@page
@model wt_lab5_5razor_yushkevich.Pages.Cargo.IndexModel
@{
    ViewData["Title"] = "Грузы";
}

<div class="page-heading">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a asp-page="/Index">Главная</a></li>
                <li class="breadcrumb-item active" aria-current="page">Грузы</li>
            </ol>
        </nav>
        <h1 class="h2 fw-bold mb-2">Каталог грузов</h1>
        <p class="text-muted mb-0">
            Все позиции склада: количество, вес, место хранения и статус.
        </p>
    </div>
    <a asp-page="/Cargo/Create" class="btn btn-primary btn-lg shadow-sm">
        <svg class="icon me-1" aria-hidden="true"><use href="#i-plus" /></svg>
        Добавить груз
    </a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <svg class="icon me-1" aria-hidden="true"><use href="#i-check" /></svg>
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть"></button>
    </div>
}

<form method="get" class="filter-panel card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3 p-md-4">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-lg-5">
                <label asp-for="Search" class="form-label small fw-semibold">Поиск</label>
                <div class="input-group">
                    <span class="input-group-text bg-white">
                        <svg class="icon" aria-hidden="true"><use href="#i-search" /></svg>
                    </span>
                    <input asp-for="Search"
                           class="form-control"
                           placeholder="Название, место хранения или описание" />
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <label asp-for="Category" class="form-label small fw-semibold">Категория</label>
                <select asp-for="Category" asp-items="Model.Categories" class="form-select">
                    <option value="">Все категории</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-4 d-flex gap-2">
                <button type="submit" class="btn btn-dark flex-grow-1">
                    Применить
                </button>
                <a asp-page="/Cargo/Index" class="btn btn-outline-secondary" title="Сбросить фильтры">
                    Сбросить
                </a>
            </div>
        </div>
    </div>
</form>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <p class="text-muted mb-0">
        Найдено <strong>@Model.Cargoes.Count</strong> из <strong>@Model.TotalCount</strong> позиций
        @if (Model.HasFilters)
        {
            <span class="badge text-bg-light border ms-1">Фильтр активен</span>
        }
    </p>
    <span class="text-muted small">Данные хранятся в памяти приложения</span>
</div>

@if (Model.Cargoes.Count > 0)
{
    <div class="row g-4">
        @foreach (var cargo in Model.Cargoes)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <partial name="_CargoCard" model="cargo" />
            </div>
        }
    </div>
}
else
{
    <div class="empty-state card border-0 shadow-sm rounded-4 text-center">
        <div class="card-body p-5">
            <span class="empty-state__icon">
                <svg class="icon" aria-hidden="true"><use href="#i-box" /></svg>
            </span>
            <h2 class="h4 fw-semibold mt-3">Ничего не найдено</h2>
            <p class="text-muted">
                Попробуйте изменить запрос или сбросить фильтры — в хранилище
                по-прежнему @Model.TotalCount позиций.
            </p>
            <a asp-page="/Cargo/Index" class="btn btn-primary">Сбросить фильтры</a>
        </div>
    </div>
}
