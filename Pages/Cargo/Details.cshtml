@page
@model wt_lab5_5razor_yushkevich.Pages.Cargo.DetailsModel
@{
    ViewData["Title"] = Model.Cargo?.Name ?? "Груз";
    var cargo = Model.Cargo!;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb mb-3">
        <li class="breadcrumb-item"><a asp-page="/Index">Главная</a></li>
        <li class="breadcrumb-item"><a asp-page="/Cargo/Index">Грузы</a></li>
        <li class="breadcrumb-item active" aria-current="page">@cargo.Name</li>
    </ol>
</nav>

<div class="detail-hero rounded-4 overflow-hidden mb-4">
    <div class="p-4 p-lg-5">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <span class="badge text-bg-light rounded-pill">ID: @cargo.Id</span>
            <span class="badge rounded-pill @(cargo.IsAvailable ? "text-bg-success" : "text-bg-secondary")">
                @cargo.Status
            </span>
            <span class="badge detail-category rounded-pill">@cargo.Category</span>
        </div>
        <h1 class="display-6 fw-bold mb-2">@cargo.Name</h1>
        <p class="detail-description mb-0">@cargo.Description</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-transparent border-0 pt-4 px-4">
                <h2 class="h5 fw-semibold mb-0">Характеристики груза</h2>
            </div>
            <div class="card-body p-4">
                <div class="row g-0 detail-grid">
                    <div class="col-12 col-sm-6 detail-cell">
                        <span class="detail-label">Название</span>
                        <span class="detail-value">@cargo.Name</span>
                    </div>
                    <div class="col-12 col-sm-6 detail-cell">
                        <span class="detail-label">Категория</span>
                        <span class="detail-value">@cargo.Category</span>
                    </div>
                    <div class="col-12 col-sm-6 detail-cell">
                        <span class="detail-label">Количество</span>
                        <span class="detail-value">@cargo.Quantity.ToString("N0") шт.</span>
                    </div>
                    <div class="col-12 col-sm-6 detail-cell">
                        <span class="detail-label">Вес одной единицы</span>
                        <span class="detail-value">@cargo.Weight.ToString("N2") кг</span>
                    </div>
                    <div class="col-12 col-sm-6 detail-cell">
                        <span class="detail-label">Общий вес партии</span>
                        <span class="detail-value">@cargo.TotalWeight.ToString("N2") кг</span>
                    </div>
                    <div class="col-12 col-sm-6 detail-cell">
                        <span class="detail-label">Место хранения</span>
                        <span class="detail-value">@cargo.Location</span>
                    </div>
                    <div class="col-12 col-sm-6 detail-cell">
                        <span class="detail-label">Статус</span>
                        <span class="detail-value">
                            <span class="badge rounded-pill @(cargo.IsAvailable ? "text-bg-success" : "text-bg-secondary")">
                                @cargo.Status
                            </span>
                        </span>
                    </div>
                    <div class="col-12 col-sm-6 detail-cell">
                        <span class="detail-label">Идентификатор</span>
                        <span class="detail-value">#@cargo.Id</span>
                    </div>
                </div>

                <hr class="my-4" />

                <h3 class="h6 text-uppercase text-muted fw-semibold mb-2">Описание</h3>
                <p class="mb-0">@cargo.Description</p>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <h2 class="h6 text-uppercase text-muted fw-semibold mb-3">Сводка</h2>
                <div class="d-flex justify-content-between border-bottom py-2">
                    <span class="text-muted">Позиций в партии</span>
                    <strong>@cargo.Quantity.ToString("N0")</strong>
                </div>
                <div class="d-flex justify-content-between border-bottom py-2">
                    <span class="text-muted">Общий вес</span>
                    <strong>@cargo.TotalWeight.ToString("N2") кг</strong>
                </div>
                <div class="d-flex justify-content-between py-2">
                    <span class="text-muted">Доступность</span>
                    <strong class="@(cargo.IsAvailable ? "text-success" : "text-secondary")">@cargo.Status</strong>
                </div>
            </div>
        </div>

        <div class="d-grid gap-2">
            <a asp-page="/Cargo/Edit" asp-route-id="@cargo.Id" class="btn btn-primary btn-lg">
                <svg class="icon me-1" aria-hidden="true"><use href="#i-pencil" /></svg>
                Редактировать
            </a>
            <a asp-page="/Cargo/Delete" asp-route-id="@cargo.Id" class="btn btn-outline-danger">
                <svg class="icon me-1" aria-hidden="true"><use href="#i-trash" /></svg>
                Удалить груз
            </a>
            <a asp-page="/Cargo/Index" class="btn btn-outline-secondary">
                <svg class="icon me-1" aria-hidden="true"><use href="#i-arrow-left" /></svg>
                Назад к списку
            </a>
        </div>
    </div>
</div>
