@page
@model wt_lab5_5razor_yushkevich.Pages.Cargo.CreateModel
@{
    ViewData["Title"] = "Добавить груз";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb mb-3">
        <li class="breadcrumb-item"><a asp-page="/Index">Главная</a></li>
        <li class="breadcrumb-item"><a asp-page="/Cargo/Index">Грузы</a></li>
        <li class="breadcrumb-item active" aria-current="page">Добавление</li>
    </ol>
</nav>

<div class="page-heading mb-4">
    <div>
        <h1 class="h2 fw-bold mb-2">Новый груз</h1>
        <p class="text-muted mb-0">
            Заполните карточку груза. Обязательные поля отмечены звёздочкой.
        </p>
    </div>
    <a asp-page="/Cargo/Index" class="btn btn-outline-secondary">
        <svg class="icon me-1" aria-hidden="true"><use href="#i-arrow-left" /></svg>
        Назад к списку
    </a>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-8">
        <form method="post" class="card border-0 shadow-sm rounded-4" novalidate>
            <div class="card-body p-4 p-lg-5">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger d-flex gap-2" role="alert">
                        <svg class="icon flex-shrink-0 mt-1" aria-hidden="true"><use href="#i-alert" /></svg>
                        <div>
                            <strong>Не удалось сохранить груз.</strong>
                            <div asp-validation-summary="ModelOnly" class="small mb-0 mt-1"></div>
                        </div>
                    </div>
                }

                <div class="row g-3 g-md-4">
                    <div class="col-12">
                        <label asp-for="Cargo.Name" class="form-label fw-semibold">
                            Название <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Cargo.Name"
                               class="form-control form-control-lg"
                               placeholder="Например, ноутбуки Dell Latitude" />
                        <span asp-validation-for="Cargo.Name" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Cargo.Category" class="form-label fw-semibold">
                            Категория <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Cargo.Category"
                               class="form-control"
                               list="category-options"
                               placeholder="Электроника" />
                        <datalist id="category-options">
                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category"></option>
                            }
                        </datalist>
                        <span asp-validation-for="Cargo.Category" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Cargo.Location" class="form-label fw-semibold">
                            Место хранения <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Cargo.Location"
                               class="form-control"
                               placeholder="Сектор A-1, стеллаж 3" />
                        <span asp-validation-for="Cargo.Location" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label asp-for="Cargo.Quantity" class="form-label fw-semibold">
                            Количество, шт. <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Cargo.Quantity"
                               class="form-control"
                               type="number"
                               min="1"
                               step="1" />
                        <span asp-validation-for="Cargo.Quantity" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label asp-for="Cargo.Weight" class="form-label fw-semibold">
                            Вес одной единицы, кг <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Cargo.Weight"
                               class="form-control"
                               type="number"
                               min="0.01"
                               step="0.01" />
                        <span asp-validation-for="Cargo.Weight" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Cargo.Description" class="form-label fw-semibold">
                            Описание <span class="text-danger">*</span>
                        </label>
                        <textarea asp-for="Cargo.Description"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Кратко опишите груз, условия хранения или поставку"></textarea>
                        <div class="form-text">До 300 символов.</div>
                        <span asp-validation-for="Cargo.Description" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <div class="form-check form-switch p-3 ps-5 rounded-3 bg-light border">
                            <input asp-for="Cargo.IsAvailable" class="form-check-input" role="switch" />
                            <label asp-for="Cargo.IsAvailable" class="form-check-label fw-semibold"></label>
                            <div class="form-text mb-0">Если выключено, груз будет отмечен как недоступный.</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-footer bg-transparent border-top p-4 d-flex flex-column flex-sm-row gap-2 justify-content-between">
                <a asp-page="/Cargo/Index" class="btn btn-outline-secondary order-2 order-sm-1">
                    Отмена
                </a>
                <button type="submit" class="btn btn-primary btn-lg px-4 order-1 order-sm-2">
                    <svg class="icon me-1" aria-hidden="true"><use href="#i-check" /></svg>
                    Сохранить груз
                </button>
            </div>
        </form>
    </div>

    <div class="col-12 col-lg-4">
        <aside class="card border-0 shadow-sm rounded-4 bg-dark text-white mb-4">
            <div class="card-body p-4">
                <span class="badge text-bg-warning rounded-pill mb-3">Подсказка</span>
                <h2 class="h5 fw-semibold">Как заполнить карточку</h2>
                <ul class="list-unstyled small mb-0 mt-3 d-grid gap-3">
                    <li class="d-flex gap-2">
                        <svg class="icon flex-shrink-0 text-warning" aria-hidden="true"><use href="#i-check" /></svg>
                        <span>Название должно быть уникальным и понятным кладовщику.</span>
                    </li>
                    <li class="d-flex gap-2">
                        <svg class="icon flex-shrink-0 text-warning" aria-hidden="true"><use href="#i-pin" /></svg>
                        <span>Укажите сектор и стеллаж — так груз быстрее найти.</span>
                    </li>
                    <li class="d-flex gap-2">
                        <svg class="icon flex-shrink-0 text-warning" aria-hidden="true"><use href="#i-weight" /></svg>
                        <span>Вес указывается для одной единицы, общий рассчитывается автоматически.</span>
                    </li>
                </ul>
            </div>
        </aside>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <h2 class="h6 text-uppercase text-muted fw-semibold">Единое хранилище</h2>
                <p class="mb-2">
                    Сейчас в <code>CargoStore</code> хранится
                    <strong>@wt_lab5_5razor_yushkevich.Data.CargoStore.Cargoes.Count</strong> позиций.
                </p>
                <p class="text-muted small mb-0">
                    Новый груз сразу появится в каталоге и будет доступен на всех страницах приложения.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
