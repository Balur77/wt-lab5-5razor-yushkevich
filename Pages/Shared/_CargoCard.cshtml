@model wt_lab5_5razor_yushkevich.Models.Cargo

@{
    var visualClass = Model.Category switch
    {
        "Электроника" => "cargo-visual--blue",
        "Мебель" => "cargo-visual--amber",
        "Инструменты" => "cargo-visual--violet",
        "Медицина" => "cargo-visual--rose",
        "Бытовая техника" => "cargo-visual--teal",
        _ => "cargo-visual--slate"
    };

    var iconId = Model.Category switch
    {
        "Электроника" => "i-cpu",
        "Мебель" => "i-chair",
        "Инструменты" => "i-tools",
        "Медицина" => "i-medical",
        _ => "i-box"
    };
}

<article class="cargo-card card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="cargo-visual @visualClass">
        <span class="badge text-bg-dark bg-opacity-75 rounded-pill">ID: @Model.Id</span>
        <svg class="cargo-visual__icon" aria-hidden="true"><use href="#@iconId" /></svg>
        <span class="badge rounded-pill @(Model.IsAvailable ? "text-bg-success" : "text-bg-secondary")">
            @Model.Status
        </span>
    </div>

    <div class="card-body d-flex flex-column p-4">
        <p class="cargo-category mb-2">@Model.Category</p>
        <h3 class="h5 card-title fw-semibold mb-2">
            <a asp-page="/Cargo/Details"
               asp-route-id="@Model.Id"
               class="cargo-title-link">
                @Model.Name
            </a>
        </h3>
        <p class="text-muted small cargo-description flex-grow-1 mb-3">
            @Model.Description
        </p>

        <dl class="cargo-meta row row-cols-2 g-2 mb-0">
            <div class="col">
                <dt>Количество</dt>
                <dd>@Model.Quantity.ToString("N0") шт.</dd>
            </div>
            <div class="col">
                <dt>Общий вес</dt>
                <dd>@Model.TotalWeight.ToString("N2") кг</dd>
            </div>
            <div class="col-12">
                <dt>Хранение</dt>
                <dd class="text-truncate" title="@Model.Location">@Model.Location</dd>
            </div>
        </dl>
    </div>

    <div class="card-footer bg-transparent border-0 px-4 pb-4 pt-0 d-flex gap-2">
        <a asp-page="/Cargo/Details"
           asp-route-id="@Model.Id"
           class="btn btn-sm btn-primary flex-grow-1">
            Подробнее
        </a>
        <a asp-page="/Cargo/Edit"
           asp-route-id="@Model.Id"
           class="btn btn-sm btn-outline-secondary">
            <svg class="icon" aria-hidden="true"><use href="#i-pencil" /></svg>
            <span class="visually-hidden">Изменить</span>
        </a>
    </div>
</article>
