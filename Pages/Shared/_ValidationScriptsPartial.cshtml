<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
<script>
    // Русские сообщения клиентской валидации для стандартных правил jQuery Validation.
    if (window.jQuery && jQuery.validator) {
        jQuery.extend(jQuery.validator.messages, {
            required: "Заполните это поле",
            number: "Введите число",
            range: jQuery.validator.format("Введите значение от {0} до {1}"),
            min: jQuery.validator.format("Значение должно быть не меньше {0}"),
            max: jQuery.validator.format("Значение должно быть не больше {0}"),
            length: jQuery.validator.format("Введите от {0} до {1} символов"),
            maxlength: jQuery.validator.format("Введите не более {0} символов"),
            minlength: jQuery.validator.format("Введите не менее {0} символов")
        });
    }
</script>
